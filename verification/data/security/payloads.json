  "payloads": [
    {
      "id": "sec.sql.basic_or_true",
      "purpose": "Detect SQL injection handling in text fields",
      "category": "sql_injection",
      "risk": "injection",
      "payload": "' OR '1'='1",
      "expected_behavior": "treat_as_inert_text_or_reject_with_structured_error",
      "applicable_transports": ["http", "websocket", "import"],
      "traceability": {"scenario_categories": ["Privacy", "Import", "Backend"]}
    },
    {
      "id": "sec.nosql.operator",
      "purpose": "Detect NoSQL-style operator injection",
      "category": "nosql_injection",
      "risk": "injection",
