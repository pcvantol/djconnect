{
  "schema_version": "1.0",
  "profile_version": "1.0",
  "id": "performance",
  "purpose": "Large but bounded data for latency, memory and transport tests",
  "generator_refs": ["performance.large_payloads.v1"],
  "selection": {
    "payload_sizes": ["typical", "large", "maximum"],
