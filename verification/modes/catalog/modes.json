{
  "schema_version": "1.0",
  "catalog_version": "1.0",
  "modes": [
    {
      "id": "functional",
      "purpose": "Validate expected behavior in nominal conditions",
      "scope": ["happy_path", "nominal_cases", "expected_contracts"],
      "assertions": ["expected_result", "structured_response", "ownership_boundary"],
      "evidence": ["request", "response", "logs", "environment"],
      "metrics": ["pass_rate", "duration_seconds"],
      "exit_criteria": ["critical_functional_scenarios_pass"],
      "recommended_data_profiles": ["smoke", "regression"],
      "applicable_scenario_categories": ["Setup", "Profiles", "Resolver", "Ask DJ", "Music DNA", "Discover", "Track Insight", "Playback", "Backend", "Capabilities", "Export", "Import"],
      "required_matrix_dimensions": ["Client Platform", "Runtime", "Profile", "Session"],
      "typical_runtime": "short",
      "typical_cost": "low",
      "traceability": {
        "quality_attributes": ["correctness", "contract"],
        "platform_principles": ["backend_ownership", "profile_as_identity"],
        "risk_categories": ["regression", "contract_drift"]
      }
    },
    {
      "id": "boundary",
      "purpose": "Validate limits and edge conditions",
      "scope": ["min", "max", "overflow", "underflow", "optional_fields", "required_fields", "field_lengths", "empty_values", "unexpected_values"],
      "assertions": ["structured_error", "no_crash", "bounded_storage", "bounded_response"],
      "evidence": ["request", "response", "logs"],
      "metrics": ["boundary_pass_rate", "error_shape_consistency"],
      "exit_criteria": ["no_unhandled_boundary_failure"],
      "recommended_data_profiles": ["boundary", "regression"],
