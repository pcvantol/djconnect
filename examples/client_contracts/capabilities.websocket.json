{
  "success": true,
  "domain": "djconnect",
  "websocket_supported": true,
  "commands": [
    "djconnect/command",
    "djconnect/ask_dj/message",
    "djconnect/ask_dj/history",
    "djconnect/ask_dj/history/clear",
    "djconnect/ask_dj/history/state",
    "djconnect/ask_dj/idle_suggestion",
    "djconnect/track_insight",
    "djconnect/music_dna/profile",
    "djconnect/music_dna/settings",
    "djconnect/music_dna/clear",
    "djconnect/music_dna/import",
    "djconnect/music_dna/export",
    "djconnect/music_discovery/feed",
    "djconnect/music_discovery/refresh",
    "djconnect/music_discovery/play",
    "djconnect/music_discovery/feedback",
    "djconnect/session/broadcast/subscribe",
    "djconnect/session/broadcast/recover"
  ],
  "features": {
    "ask_dj_chat": true,
    "ask_dj_history": true,
    "ask_dj_idle_suggestion": true,
    "backend_commands": true,
    "track_insight": true,
    "music_dna": true,
    "music_discovery": true,
    "music_discovery_feedback": true,
    "session_broadcast_transport": true
  },
  "fallbacks": {
    "music_dna": {
      "available": true,
      "preferred_transport": "websocket",
      "http_paths": {
        "profile": "/api/djconnect/v1/music_dna/profile",
        "settings": "/api/djconnect/v1/music_dna/settings",
        "clear": "/api/djconnect/v1/music_dna/clear",
        "import": "/api/djconnect/v1/music_dna/import",
        "export": "/api/djconnect/v1/music_dna/export"
      },
      "missing_behavior": "use_http_or_hide_feature"
    },
    "music_discovery": {
      "available": true,
      "preferred_transport": "websocket",
      "http_paths": {
        "feed": "/api/djconnect/v1/music_discovery",
        "refresh": "/api/djconnect/v1/music_discovery/refresh",
        "play": "/api/djconnect/v1/music_discovery/play"
      },
      "missing_behavior": "use_http_or_hide_feature"
    },
    "music_discovery_feedback": {
      "available": true,
      "preferred_transport": "websocket",
      "http_path": "/api/djconnect/v1/music_discovery/feedback",
      "missing_behavior": "hide_negative_feedback_controls"
    }
  },
  "capabilities": {
    "profiles": true,
    "explicit_profile_selection": true,
    "private_sessions": true,
    "profile_export": true,
    "request_context": true,
    "voice_endpoint_request_context": true,
    "voice_endpoint_mappings": true,
    "session_conversation_history": true,
    "ask_dj_contextual_dialogue": true,
    "moment_track_insight_navigation_v1": true,
    "session_flow_text_search": true,
    "active_session_mood": true,
    "active_session_presence": true,
    "session_forecast": true,
    "session_history_summary": true,
    "hybrid_transport": true,
    "session_artwork": true,
    "active_session_persona": true,
    "session_speech": true
  },
  "contract_versions": {
    "profile_context": 1,
    "client_contract_fixtures": 1,
    "session_conversation_history": 1,
    "ask_dj_contextual_dialogue": 1,
    "moment_track_insight_navigation": 1,
    "session_flow_text_search": 1,
    "active_session_mood": 1,
    "active_session_presence": 1,
    "session_forecast": 1,
    "session_history_summary": 1,
    "hybrid_transport": 1,
    "session_artwork": 1,
    "active_session_persona": 1,
    "session_speech": 1
  },
  "transports": {
    "http": true,
    "websocket": true
  },
  "hybrid_transport": {
    "available": true,
    "version": 1,
    "requires_authenticated_tls": true,
    "transport_security": {
      "policy_version": 1,
      "deployment_qualification_required": true,
      "external": "authenticated_tls",
      "local_plaintext": "qualified_direct_only",
      "peer_policy": "enabled_interface_subnet_or_loopback",
      "internal_origin_required": true,
      "forwarded_plaintext": "forbidden"
    },
    "client_types": [
      "ios",
      "macos",
      "watchos"
    ],
    "audience": "paired_owner_actions",
    "path": "/api/djconnect/v1/actions/paired",
    "auth": "paired_device_first_frame",
    "ha_credentials_issued": false,
    "commands": [
      "djconnect/read",
      "djconnect/operation/execute",
      "djconnect/operation/status"
    ],
    "context_path": "/api/djconnect/v1/transport/context",
    "operation_path": "/api/djconnect/v1/transport/operation",
    "status_path": "/api/djconnect/v1/transport/operation/status",
    "recovery_path": "/api/djconnect/v1/session/broadcast/recovery",
    "lease_seconds": 300,
    "auth_timeout_seconds": 5,
    "revocation_check_seconds": 1,
    "heartbeat_seconds": 15,
    "frame_bytes": 65536,
    "pending_limit": 8,
    "outgoing_queue_limit": 64,
    "connection_request_limit": 256,
    "connection_limit": 16,
    "paired_device_connection_limit": 2,
    "operation_identity": "uuidv7",
    "operation_lifetime_ms": 300000,
    "after_send_retry": "reconcile_original_operation_only",
    "cross_origin_redirects": "forbidden",
    "browser_origin": "same_https_origin_only",
    "native_adoption": "separate_consumer_qualification"
  }
}
