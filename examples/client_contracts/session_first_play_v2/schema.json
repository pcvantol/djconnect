{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pcvantol/djconnect/session-first-play-v2/schema.json",
  "title": "Session startup Music DNA surprise mix v2 and navigation-only choices",
  "$defs": {
    "catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "available",
        "label",
        "prompt",
        "localizations",
        "mix_availability",
        "transport",
        "selection_effect",
        "automatic_playback",
        "genre_basis",
        "unavailable_reason"
      ],
      "properties": {
        "schema_version": {
          "const": 2,
          "type": "integer"
        },
        "id": {
          "const": "session_first_play_surprise_mix"
        },
        "available": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "localizations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "nl",
            "de",
            "fr",
            "es"
          ],
          "properties": {
            "en": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "prompt"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                }
              }
            },
            "nl": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "prompt"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                }
              }
            },
            "de": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "prompt"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                }
              }
            },
            "fr": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "prompt"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                }
              }
            },
            "es": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "prompt"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                }
              }
            }
          }
        },
        "mix_availability": {
          "const": "not_queried"
        },
        "transport": {
          "const": "existing_session_conversation"
        },
        "selection_effect": {
          "const": "genre_starts_exact_mix"
        },
        "automatic_playback": {
          "const": false,
          "type": "boolean"
        },
        "genre_basis": {
          "const": "music_dna"
        },
        "unavailable_reason": {
          "enum": [
            null,
            "startup_or_music_dna_unavailable"
          ]
        },
        "kind": {
          "const": "conversation_request"
        }
      }
    },
    "first_play": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "state",
        "selection_effect",
        "reason",
        "genre_basis"
      ],
      "properties": {
        "schema_version": {
          "const": 2,
          "type": "integer"
        },
        "state": {
          "enum": [
            "output",
            "genres",
            "requested",
            "uncertain",
            "unavailable"
          ]
        },
        "selection_effect": {
          "const": "genre_starts_exact_mix"
        },
        "reason": {
          "enum": [
            null,
            "session_or_source_unavailable",
            "no_confirmed_output",
            "provider_unavailable",
            "fewer_than_three_playable_mixes",
            "music_dna_unavailable"
          ]
        },
        "expires_in": {
          "type": "number",
          "minimum": 0,
          "maximum": 60
        },
        "genre_basis": {
          "const": "music_dna"
        }
      }
    },
    "playlist_navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "kind",
        "available",
        "destination",
        "label",
        "localizations",
        "automatic_playback"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "id": {
          "const": "session_start_playlists"
        },
        "kind": {
          "const": "navigation"
        },
        "available": {
          "type": "boolean"
        },
        "destination": {
          "const": "playlists"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "localizations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "nl",
            "de",
            "fr",
            "es"
          ],
          "properties": {
            "en": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            },
            "nl": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            },
            "de": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            },
            "fr": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            },
            "es": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                }
              }
            }
          }
        },
        "automatic_playback": {
          "const": false
        }
      }
    },
    "session_start_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "available",
        "automatic_playback",
        "items"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "available": {
          "type": "boolean"
        },
        "automatic_playback": {
          "const": false
        },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/catalogue"
                },
                {
                  "required": [
                    "kind"
                  ]
                }
              ]
            },
            {
              "$ref": "#/$defs/playlist_navigation"
            }
          ],
          "items": false
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/catalogue"
    },
    {
      "$ref": "#/$defs/first_play"
    },
    {
      "$ref": "#/$defs/session_start_actions"
    }
  ]
}
