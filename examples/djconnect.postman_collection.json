            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/command",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "command"
              ]
            },
            "description": "Playback mutation example: pause the current backend playback."
          }
        },
        {
          "name": "Command - set volume",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"command\": \"set_volume\",\n  \"value\": 35\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/command",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "command"
              ]
            },
            "description": "Playback mutation example: set backend playback volume."
          }
        },
        {
          "name": "Post event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"event\": \"app_opened\",\n  \"payload\": {\n    \"screen\": \"ask_dj\"\n  }\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/event",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "event"
              ]
            },
            "description": "Authenticated client event endpoint."
          }
        }
      ]
    },
    {
      "name": "Ask DJ",
      "item": [
        {
          "name": "Ask DJ - informational",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_message_id\": \"{{$guid}}\",\n  \"client_id\": \"{{device_id}}\",\n  \"identity\": {\n    \"device_id\": \"{{device_id}}\",\n    \"client_type\": \"{{client_type}}\",\n    \"device_name\": \"{{device_name}}\"\n  },\n  \"text\": \"Waarom koos je dit nummer?\",\n  \"music_dna_key\": \"{{music_dna_key}}\",\n  \"mood\": 42,\n  \"mood_zone\": \"groove\",\n  \"dj_style\": \"warm_radio_dj\",\n  \"audio_response\": \"auto\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/ask_dj/message",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "ask_dj",
                "message"
              ]
            },
            "description": "Informational Ask DJ message request. This should not mutate playback and stores the user/assistant exchange in server-side HA-user history. audio_response auto keeps informational text chat text-only unless the client sends always."
          }
        },
        {
          "name": "Ask DJ - personal music profile analysis",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_message_id\": \"{{$guid}}\",\n  \"client_id\": \"{{device_id}}\",\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"device_name\": \"{{device_name}}\",\n  \"text\": \"Omschrijf eens waar ik zoal naar luisterde de afgelopen maand\",\n  \"music_dna_key\": \"{{music_dna_key}}\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/ask_dj/message",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "ask_dj",
                "message"
              ]
            },
            "description": "Personal music profile analysis intent. Expected intent: personal_music_profile_analysis. This must not mutate playback. Response should include sources[] such as spotify_recently_played, spotify_top_tracks_short_term and djconnect_music_dna when data is available."
          }
        },
        {
          "name": "Ask DJ - recently played history",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_message_id\": \"{{$guid}}\",\n  \"client_id\": \"{{device_id}}\",\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"device_name\": \"{{device_name}}\",\n  \"text\": \"Welke nummers heb ik afgelopen uur afgespeeld?\",\n  \"music_dna_key\": \"{{music_dna_key}}\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/ask_dj/message",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "ask_dj",
                "message"
              ]
            },
            "description": "Recent listening-history intent. Expected intent: recently_played_history with intent.item_type tracks, albums, artists or playlists. Response should include items[], assistant_message.items[], images[] and source spotify_recently_played, and must not mutate playback."
          }
        },
        {
          "name": "Ask DJ - personal recommendations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_message_id\": \"{{$guid}}\",\n  \"client_id\": \"{{device_id}}\",\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"device_name\": \"{{device_name}}\",\n  \"text\": \"Welke muziek raad je mij aan?\",\n  \"music_dna_key\": \"{{music_dna_key}}\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/ask_dj/message",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "ask_dj",
                "message"
              ]
            },
            "description": "Requests non-mutating personal recommendations. Expected response can include playback_actions[] for client Play Now buttons."
          }
        },
        {
          "name": "Ask DJ - morning startup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_message_id\": \"{{$guid}}\",\n  \"client_id\": \"{{device_id}}\",\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"device_name\": \"{{device_name}}\",\n  \"text\": \"Goedemorgen\",\n  \"trigger\": \"morning_startup\",\n  \"reason\": \"app_started_without_active_playback\",\n  \"has_active_now_playing\": \"false\",\n  \"local_date\": \"2026-06-20\",\n  \"local_hour\": \"8\",\n  \"music_dna_key\": \"{{music_dna_key}}\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/ask_dj/message",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "ask_dj",
                "message"
              ]
            },
            "description": "Morning startup Ask DJ message. If there is no active playback, backend should answer with a friendly morning suggestion and confirmation playback_actions[] with Ja/Nee, without starting playback automatically."
          }
        },
        {
          "name": "Ask DJ - Play Now recommendation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"command\": \"ask_dj_play_recommendation\",\n  \"play\": true,\n  \"value\": {\n    \"backend\": \"spotify_direct\",\n    \"provider\": \"spotify\",\n    \"music_backend_revision\": 1,\n    \"title\": \"Track Title\",\n    \"subtitle\": \"Artist Name\",\n    \"uri\": \"spotify:track:123\",\n    \"context_uri\": \"spotify:album:456\",\n    \"offset_uri\": \"spotify:track:123\",\n    \"kind\": \"track\",\n    \"music_dna_key\": \"{{music_dna_key}}\",\n    \"reason\": \"Past bij je recente voorkeur voor melodische opbouw.\",\n    \"value\": {\n      \"uri\": \"spotify:track:123\",\n      \"title\": \"Track Title\",\n      \"subtitle\": \"Artist Name\",\n      \"image_url\": \"{{image_url}}\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/command",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "command"
              ]
            },
            "description": "Explicit Play Now command for a recommendation returned by Ask DJ playback_actions[]. This is the point where playback may start."
          }
        },
        {
          "name": "Ask DJ - follow-up confirmation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"command\": \"ask_dj_followup_response\",\n  \"value\": {\n    \"title\": \"Ja\",\n    \"kind\": \"confirmation\",\n    \"action_style\": \"confirmation\",\n    \"response_value\": \"yes\",\n    \"music_dna_key\": \"{{music_dna_key}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/command",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "command"
              ]
            },
            "description": "Responds to the latest pending Ask DJ confirmation question. response_value yes executes the stored proposed action; no declines without playback. Backend appends an assistant message to server-side Ask DJ history."
          }
        },
        {
          "name": "Ask DJ - playback action",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_message_id\": \"{{$guid}}\",\n  \"client_id\": \"{{device_id}}\",\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"text\": \"Volgende nummer\",\n  \"music_dna_key\": \"{{music_dna_key}}\",\n  \"audio_response\": \"auto\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/ask_dj/message",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "ask_dj",
                "message"
              ]
            },
            "description": "Ask DJ playback action example. This can mutate playback."
          }
        },
        {
          "name": "Track Insight",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ha_access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Innerbloom\",\n  \"artist\": \"RUFUS DU SOL\",\n  \"album\": \"Bloom\",\n  \"force_refresh\": false,\n  \"include_visual_profile\": true,\n  \"include_raw_response\": false,\n  \"locale\": \"en\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/track_insight",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "track_insight"
              ]
            },
            "description": "Standalone Track Insight endpoint for Apple and future clients. Uses Home Assistant auth and returns normalized TrackInsight JSON with track metadata, structured analysis, cache info and optional visual-profile hints. Track Insight does not include a Music DNA per-track match score."
          }
        },
        {
          "name": "Ask DJ - clear history",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/ask_dj/history/clear",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "ask_dj",
                "history",
                "clear"
              ]
            },
            "description": "Clears persistent server-side DJConnect app Ask DJ chat history for the authenticated HA user/context and increments clear_revision/history_revision so clients wipe their local cache on next sync."
          }
        },
        {
          "name": "Ask DJ - sync history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              },
              {
                "key": "X-DJConnect-Client-Type",
                "value": "{{client_type}}"
              }
            ],
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/ask_dj/history?since_revision={{history_generation}}",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "ask_dj",
                "history"
              ],
              "query": [
                {
                  "key": "since_revision",
                  "value": "{{history_generation}}"
                }
              ]
            },
            "description": "Synchronizes persistent HA-user Ask DJ history. Response includes user_id, history_revision, clear_revision, bounded messages[] and server_time."
          }
        },
        {
          "name": "Music DNA - profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"music_dna_key\": \"{{music_dna_key}}\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/music_dna/profile",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "music_dna",
                "profile"
              ]
            },
            "description": "Fetches the structured server-side Music DNA profile for the client screen. If enabled is false, clients should show the opt-in/empty state instead of deriving a persistent profile from local Track Insight history."
          }
        },
        {
          "name": "Music DNA - set enabled",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"enabled\": true\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/music_dna/settings",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "music_dna",
                "settings"
              ]
            },
            "description": "Opts the resolved user/client context in or out of Music DNA. Disabling clears learned DNA and stops future knowledge collection."
          }
        },
        {
          "name": "Music DNA - clear",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"music_dna_key\": \"{{music_dna_key}}\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/music_dna/clear",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "music_dna",
                "clear"
              ]
            },
            "description": "Clears learned Music DNA while preserving the current opt-in setting. If Music DNA remains enabled, learning starts again from an empty profile."
          }
        }
      ]
    },
    {
      "name": "Apple Push",
      "item": [
        {
          "name": "Push register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"djconnect-ios-ABCDEFGHIJKL\",\n  \"client_type\": \"ios\",\n  \"push_token\": \"apns-token-from-client\",\n  \"bootstrap_proof\": \"replace-with-short-lived-bootstrap-proof\",\n  \"push_environment\": \"sandbox\",\n  \"app_bundle_id\": \"dev.djconnect.app\",\n  \"app_version\": \"3.2.15\",\n  \"locale\": \"nl-NL\",\n  \"notification_categories\": [\n    \"ask_dj_response\",\n    \"ask_dj_confirm\",\n    \"playback_change\"\n  ]\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/push/register",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "push",
                "register"
              ]
            },
            "description": "DJConnect Apple push registration is optional and best-effort. Home Assistant relays registration to the central djconnect-api after the client supplies a short-lived bootstrap proof for per-install token bootstrap. Home Assistant does not store APNs tokens. Push delivery is limited to explicit Ask DJ response/confirm attention events; playback_change is a future/default-disabled category. Clients must sync via authenticated APIs after opening."
          },
          "response": []
        },
        {
          "name": "Push unregister",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"djconnect-ios-ABCDEFGHIJKL\",\n  \"client_type\": \"ios\",\n  \"push_token\": \"apns-token-from-client\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/push/unregister",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "push",
                "unregister"
              ]
            },
            "description": "DJConnect Apple push unregister is optional and best-effort. Home Assistant relays unregister to the central djconnect-api when configured and never logs full APNs tokens."
          },
          "response": []
        }
      ]
    },
