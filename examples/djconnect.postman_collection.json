{
  "info": {
    "_postman_id": "7b2f3210-djconnect-api",
    "name": "DJConnect Home Assistant API",
    "description": "Postman collection for the DJConnect Home Assistant custom integration. Set collection variables before running requests. Do not commit real bearer tokens, pairing codes, Spotify OAuth values or Home Assistant tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "ha_base_url",
      "value": "http://homeassistant.local:8123",
      "type": "string"
    },
    {
      "key": "device_token",
      "value": "replace-with-djconnect-device-bearer-token",
      "type": "string"
    },
    {
      "key": "ha_access_token",
      "value": "replace-with-home-assistant-long-lived-access-token",
      "type": "string"
    },
    {
      "key": "device_id",
      "value": "djconnect-watchos-68B74487726D",
      "type": "string"
    },
    {
      "key": "client_type",
      "value": "watchos",
      "type": "string"
    },
    {
      "key": "device_name",
      "value": "Apple Watch van Peter",
      "type": "string"
    },
    {
      "key": "pair_code",
      "value": "469781",
      "type": "string"
    },
    {
      "key": "music_dna_key",
      "value": "postman-shared-memory",
      "type": "string"
    },
    {
      "key": "history_generation",
      "value": "0",
      "type": "string"
    },
    {
      "key": "tts_token",
      "value": "replace-with-token-from-audio-url",
      "type": "string"
    },
    {
      "key": "tts_extension",
      "value": "mp3",
      "type": "string"
    },
    {
      "key": "image_token",
      "value": "replace-with-token-from-image-proxy-url",
      "type": "string"
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "Pairing",
      "item": [
        {
          "name": "Pair app/client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pair_code\": \"{{pair_code}}\",\n  \"pairing_code\": \"{{pair_code}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"platform\": \"{{client_type}}\",\n  \"device_id\": \"{{device_id}}\",\n  \"device_name\": \"{{device_name}}\",\n  \"firmware\": \"3.2.15\",\n  \"app_version\": \"3.2.15\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/pair",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "pair"
              ]
            },
            "description": "Pairs an app-like DJConnect client. The response can issue the bearer device token used by authenticated requests."
          }
        }
      ]
    },
    {
      "name": "Status, Commands and Events",
      "item": [
        {
          "name": "Post status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"platform\": \"{{client_type}}\",\n  \"device_name\": \"{{device_name}}\",\n  \"firmware\": \"3.2.15\",\n  \"app_version\": \"3.2.15\",\n  \"battery_percent\": 86,\n  \"mood\": 42,\n  \"mood_zone\": \"groove\",\n  \"dj_style\": \"warm_radio_dj\",\n  \"music_dna_key\": \"{{music_dna_key}}\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/status",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "status"
              ]
            },
            "description": "Authenticated client status update. App clients can include optional Music DNA hints."
          }
        },
        {
          "name": "Command - current status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
