              },
              {
                "key": "client_type",
                "value": "{{client_type}}"
              },
              {
                "key": "X-DJConnect-Mood",
                "value": "42"
              },
              {
                "key": "X-DJConnect-DJ-Style",
                "value": "warm_radio_dj"
              },
              {
                "key": "X-DJConnect-Music-DNA-Key",
                "value": "{{music_dna_key}}"
              }
