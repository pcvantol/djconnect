              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"command\": \"pause\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/command",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "command"
              ]
            },
            "description": "Playback mutation example: pause the current backend playback."
          }
        },
        {
          "name": "Command - set volume",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"command\": \"set_volume\",\n  \"value\": 35\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/command",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "command"
              ]
            },
            "description": "Playback mutation example: set backend playback volume."
          }
        },
        {
          "name": "Post event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"event\": \"app_opened\",\n  \"payload\": {\n    \"screen\": \"ask_dj\"\n  }\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/event",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "event"
              ]
            },
            "description": "Authenticated client event endpoint."
          }
        }
      ]
    },
    {
      "name": "Ask DJ",
      "item": [
        {
          "name": "Ask DJ - informational",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_message_id\": \"{{$guid}}\",\n  \"client_id\": \"{{device_id}}\",\n  \"identity\": {\n    \"device_id\": \"{{device_id}}\",\n    \"client_type\": \"{{client_type}}\",\n    \"device_name\": \"{{device_name}}\"\n  },\n  \"text\": \"Waarom koos je dit nummer?\",\n  \"memory_key\": \"{{memory_key}}\",\n  \"mood\": 42,\n  \"dj_style\": \"warm_radio_dj\",\n  \"audio_response\": \"auto\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/ask_dj/message",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "ask_dj",
                "message"
              ]
            },
            "description": "Informational Ask DJ message request. This should not mutate playback and stores the user/assistant exchange in server-side HA-user history. audio_response auto keeps informational text chat text-only unless the client sends always."
          }
        },
        {
          "name": "Ask DJ - personal music profile analysis",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_message_id\": \"{{$guid}}\",\n  \"client_id\": \"{{device_id}}\",\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"device_name\": \"{{device_name}}\",\n  \"text\": \"Omschrijf eens waar ik zoal naar luisterde de afgelopen maand\",\n  \"memory_key\": \"{{memory_key}}\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/ask_dj/message",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "ask_dj",
                "message"
              ]
            },
            "description": "Personal music profile analysis intent. Expected intent: personal_music_profile_analysis. This must not mutate playback. Response should include sources[] such as spotify_recently_played, spotify_top_tracks_short_term and djconnect_memory when data is available."
          }
        },
        {
          "name": "Ask DJ - personal recommendations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_message_id\": \"{{$guid}}\",\n  \"client_id\": \"{{device_id}}\",\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"device_name\": \"{{device_name}}\",\n  \"text\": \"Welke muziek raad je mij aan?\",\n  \"memory_key\": \"{{memory_key}}\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/ask_dj/message",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "ask_dj",
                "message"
              ]
            },
            "description": "Requests non-mutating personal recommendations. Expected response can include playback_actions[] for client Play Now buttons."
          }
        },
        {
          "name": "Ask DJ - morning startup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_message_id\": \"{{$guid}}\",\n  \"client_id\": \"{{device_id}}\",\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"device_name\": \"{{device_name}}\",\n  \"text\": \"Goedemorgen\",\n  \"trigger\": \"morning_startup\",\n  \"reason\": \"app_started_without_active_playback\",\n  \"has_active_now_playing\": \"false\",\n  \"local_date\": \"2026-06-20\",\n  \"local_hour\": \"8\",\n  \"memory_key\": \"{{memory_key}}\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/ask_dj/message",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "ask_dj",
                "message"
              ]
            },
            "description": "Morning startup Ask DJ message. If there is no active playback, backend should answer with a friendly morning suggestion and confirmation playback_actions[] with Ja/Nee, without starting playback automatically."
          }
        },
        {
          "name": "Ask DJ - Play Now recommendation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"command\": \"ask_dj_play_recommendation\",\n  \"play\": true,\n  \"value\": {\n    \"title\": \"Track Title\",\n    \"subtitle\": \"Artist Name\",\n    \"uri\": \"spotify:track:123\",\n    \"context_uri\": \"spotify:album:456\",\n    \"offset_uri\": \"spotify:track:123\",\n    \"kind\": \"track\",\n    \"memory_key\": \"{{memory_key}}\",\n    \"reason\": \"Past bij je recente voorkeur voor melodische opbouw.\"\n  }\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/command",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "command"
              ]
            },
            "description": "Explicit Play Now command for a recommendation returned by Ask DJ playback_actions[]. This is the point where playback may start."
          }
        },
        {
          "name": "Ask DJ - follow-up confirmation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"command\": \"ask_dj_followup_response\",\n  \"value\": {\n    \"title\": \"Ja\",\n    \"kind\": \"confirmation\",\n    \"action_style\": \"confirmation\",\n    \"response_value\": \"yes\",\n    \"memory_key\": \"{{memory_key}}\"\n  }\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/command",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "command"
              ]
            },
            "description": "Responds to the latest pending Ask DJ confirmation question. response_value yes executes the stored proposed action; no declines without playback. Backend appends an assistant message to server-side Ask DJ history."
          }
        },
        {
          "name": "Ask DJ - playback action",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_message_id\": \"{{$guid}}\",\n  \"client_id\": \"{{device_id}}\",\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"text\": \"Volgende nummer\",\n  \"memory_key\": \"{{memory_key}}\",\n  \"audio_response\": \"auto\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/ask_dj/message",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "ask_dj",
                "message"
              ]
            },
            "description": "Ask DJ playback action example. This can mutate playback."
          }
        },
        {
          "name": "Ask DJ - clear history",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/ask_dj/history/clear",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "ask_dj",
                "history",
                "clear"
              ]
            },
            "description": "Clears persistent server-side DJConnect app Ask DJ chat history globally and increments the shared clear_revision/history_revision so other clients wipe their local cache on next sync."
          }
        },
        {
          "name": "Ask DJ - sync history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              },
              {
                "key": "X-DJConnect-Client-Type",
                "value": "{{client_type}}"
              }
            ],
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/ask_dj/history?since_revision={{history_generation}}",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "ask_dj",
                "history"
              ],
              "query": [
                {
                  "key": "since_revision",
                  "value": "{{history_generation}}"
                }
              ]
            },
            "description": "Synchronizes persistent HA-user Ask DJ history. Response includes user_id, history_revision, clear_revision, bounded messages[] and server_time."
          }
        }
      ]
    },
    {
      "name": "Voice and Media",
      "item": [
        {
          "name": "Voice - text diagnostic",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"text\": \"Wat speelt er nu?\",\n  \"memory_key\": \"{{memory_key}}\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/voice",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "voice"
              ]
            },
            "description": "Text-only voice diagnostic. Raw WAV PTT uploads use Content-Type audio/wav and binary body instead."
          }
        },
        {
          "name": "Ask DJ voice - WAV upload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "audio/wav"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              },
              {
                "key": "client_type",
                "value": "{{client_type}}"
              },
              {
                "key": "X-DJConnect-Mood",
                "value": "42"
              },
              {
                "key": "X-DJConnect-DJ-Style",
                "value": "warm_radio_dj"
              },
              {
                "key": "X-DJConnect-Memory-Key",
                "value": "{{memory_key}}"
              }
            ],
            "body": {
              "mode": "file",
              "file": {
                "src": ""
              }
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/voice",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "voice"
              ]
            },
            "description": "Upload an audio/wav file from an iOS, macOS or watchOS Ask DJ PTT client. Backend transcribes via HA STT, routes the transcript through Ask DJ, and returns transcript, text/dj_text, optional images, links, sources and audio_url."
          }
        },
        {
          "name": "TTS audio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/tts/{{tts_token}}.{{tts_extension}}",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "tts",
                "{{tts_token}}.{{tts_extension}}"
              ]
            },
            "description": "Fetches a temporary DJConnect TTS audio URL returned by voice or Ask DJ responses."
          }
        },
        {
          "name": "Image proxy",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/image_proxy/{{image_token}}",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "image_proxy",
                "{{image_token}}"
              ]
            },
            "description": "Fetches a proxied image URL returned in Ask DJ images[]."
          }
        }
      ]
    },
    {
      "name": "Spotify OAuth Callback",
      "item": [
        {
          "name": "Spotify callback placeholder",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/spotify/callback?code=replace-with-oauth-code&state=replace-with-state",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "spotify",
                "callback"
              ],
              "query": [
                {
                  "key": "code",
                  "value": "replace-with-oauth-code"
                },
