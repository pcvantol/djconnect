              {
                "key": "Authorization",
                "value": "Bearer {{device_token}}"
              },
              {
                "key": "X-DJConnect-Device-ID",
                "value": "{{device_id}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{device_id}}\",\n  \"client_type\": \"{{client_type}}\",\n  \"command\": \"status\",\n  \"music_dna_key\": \"{{music_dna_key}}\"\n}"
            },
            "url": {
              "raw": "{{ha_base_url}}/api/djconnect/command",
              "host": [
                "{{ha_base_url}}"
              ],
              "path": [
                "api",
                "djconnect",
                "command"
              ]
            },
            "description": "Fetch backend playback/status information without mutating playback."
          }
        },
