{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:djconnect:direct-rich-session-runtime:v1",
  "title": "Direct rich Session runtime v1 closed wire",
  "description": "Source preparation; format alone supplies no display/clock/owner/provider authority. Byte, relational, unique-slot, hash, original-rights and actual lifecycle guards additionally required. Root rejects arbitrary JSON; endpoint MUST select the compiled operation binding. Raw byte/duplicate/number-token preflight is additionally mandatory; JSON Schema alone does not preserve lexical integer-vs-float syntax.",
  "$defs": {
    "authorize_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": 1,
          "type": "integer"
        },
        "device_id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^djconnect-(ios|macos)-[A-Za-z0-9]{12}$"
        },
        "client_type": {
          "enum": [
            "ios",
            "macos"
          ]
        },
        "session_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "surface": {
          "enum": [
            "widget",
            "live_activity"
          ]
        },
        "operation_id": {
          "type": "string",
          "maxLength": 36,
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        },
        "enabled": {
          "type": "boolean"
        },
        "os_snapshot_cache": {
          "type": "boolean"
        },
        "locked_display": {
          "type": "boolean"
        }
      },
      "required": [
        "contract_version",
        "device_id",
        "client_type",
        "session_id",
        "surface",
        "operation_id",
        "enabled",
        "os_snapshot_cache",
        "locked_display"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "surface": {
                "const": "live_activity"
              }
            }
          },
          "then": {
            "properties": {
              "client_type": {
                "const": "ios"
              }
            }
          }
        }
      ]
    },
    "read_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": 1,
          "type": "integer"
        },
        "purpose_id": {
          "type": "string",
          "maxLength": 36,
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
        }
      },
      "required": [
        "contract_version",
        "purpose_id"
      ]
    },
    "asset_request": {
