          "enum": [
            "widget",
            "live_activity"
          ]
        },
        "state": {
          "const": "active"
        },
        "purpose_issued_at_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "purpose_expires_at_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "request_sha256": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "frame": {
          "$ref": "#/$defs/frame"
        },
        "read_credential": {
          "type": "string",
          "maxLength": 55,
          "pattern": "^djcrichread_[A-Za-z0-9_-]{43}$"
        },
        "asset_credential": {
          "type": "string",
          "maxLength": 56,
          "pattern": "^djcrichasset_[A-Za-z0-9_-]{43}$"
        }
      },
      "required": [
        "success",
        "contract_version",
        "profile_id",
        "operation_id",
        "purpose_id",
        "surface",
        "state",
        "purpose_issued_at_ms",
        "purpose_expires_at_ms",
        "request_sha256",
        "frame",
        "read_credential",
        "asset_credential"
      ]
    },
